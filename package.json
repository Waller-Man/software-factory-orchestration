{
  "name": "@software-factory/orchestration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single AgentVersion selection with native chat, human review and Runtime execution",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./preset": "./lib/preset.js",
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "lib/typert.host.js", "lib/typert.host.d.ts", "lib/typert.remote-client.js", "lib/typert.remote-client.d.ts",
    "skills/",
    "README.md",
    "docs/images/",
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml",
    "locale/",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-alpha.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.10-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.2",
    "@software-factory/gateway": "^0.1.1",
    "@software-factory/runtime": "^0.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
